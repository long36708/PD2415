import /microtrust.rc
import /init.recovery.touch.rc

exec u:r:recovery:s0 root root -- /system/bin/sh /bcb_clear.sh

# 修正 VINTF manifest (9.0→8.0 + device fragment 归位), 必须在 servicemanager
# 启动前完成 —— svc.rc 在 on init 就 start servicemanager, 故挂在 on early-init.
# 不修则 libvintf@8.0 解析失败, servicemanager 拒绝所有 AIDL addService,
# keystore2 无法注册 IKeystoreService, recovery 无法解密 /data (设备已验证).
on early-init
    exec u:r:recovery:s0 root root -- /system/bin/sh /fix-vintf.sh

on boot
    # vivo 触摸 THP(Touch Host Processing) daemon: 内核驱动只收中断, 坐标算法
    # 跑在 /vendor/bin/vtsthp 用户态进程里. vtsthp.rc(平台片段自带) 的触发器
    # 会 start vtsthpServiceRecovery0 (seclabel recovery, 专为 recovery 设计).
    # 没有 vtsthp 时中断狂跳但 input 零事件 —— 触摸完全无响应 (设备实测).
    setprop vendor.vivo.touch.support.vtsthp_recovery0 1
    symlink /dev/block/mapper/pl_a /dev/block/by-name/preloader_raw_a
    symlink /dev/block/mapper/pl_b /dev/block/by-name/preloader_raw_b
    
    setprop sys.usb.config adb
    start adbd

    start twrpdump

   
    write /sys/class/leds/lcd-backlight/brightness 1400
    # mobicore is started from `on fs` (after persist is mounted for --P1)

    start vendor.boot-default


    start vendor.health-default

service vendor.boot-default /system/bin/hw/android.hardware.boot-service.mtk_recovery
    class early_hal
    user root
    group root
    seclabel u:r:recovery:s0
    interface aidl android.hardware.boot.IBootControl/default

service vendor.health-default /system/bin/hw/android.hardware.health-service.example_recovery
    class hal
    seclabel u:r:recovery:s0
    user system
    group system
    capabilities WAKE_ALARM BLOCK_SUSPEND
    file /dev/kmsg w


# --- Trustonic Kinibi crypto chain (recovery decrypts /data via keymint) ---
# platform.rc / vendor/etc/init/trustonic.rc both define these services, but the
# recovery init fragment imports neither, so `start mobicore` used to fail
# silently and keystore2 never reached keymint. The stock trustonic.rc also
# carries `priority -20`, which aborts the init child (it drops CAP_SYS_NICE).
# Declare both services here, in the recovery domain, with the drbin paths at
# where they actually land in the ramdisk (/vendor/mcRegistry, NOT /vendor/app).
# mcDriverDaemon sets ro.vendor.trustonic.ready=true once a trustlet answers.
service mobicore /vendor/bin/mcDriverDaemon --P1 /mnt/vendor/persist/mcRegistry \
    -r /vendor/mcRegistry/020f0000000000000000000000000000.drbin \
    -r /vendor/mcRegistry/031c0000000000000000000000000000.drbin \
    -r /vendor/mcRegistry/033c0000000000000000000000000000.drbin \
    -r /vendor/mcRegistry/05070000000000000000000000000000.drbin \
    -r /vendor/mcRegistry/05120000000000000000000000000001.drbin \
    -r /vendor/mcRegistry/06090000000000000000000000000000.drbin \
    -r /vendor/mcRegistry/07150000000000000000000000000000.drbin \
    -r /vendor/mcRegistry/07170000000000000000000000000000.drbin \
    -r /vendor/mcRegistry/07210000000000000000000000000000.drbin \
    -r /vendor/mcRegistry/08050000000000000000000000003419.drbin \
    -r /vendor/mcRegistry/40188311faf343488db888ad39496f9a.drbin \
    -r /vendor/mcRegistry/5020170115e016302017012521300000.drbin
    user root
    group root
    seclabel u:r:recovery:s0

service keymaster-5-0 /vendor/bin/hw/android.hardware.security.keymint@3.0-service.trustonic
    disabled
    user root
    group root drmrpc
    seclabel u:r:recovery:s0

# gatekeeper HIDL 1.0 (锁屏凭据路径, recovery 二进制 NEEDED libgatekeeper_aidl)
service gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper-service.trustonic
    disabled
    user root
    group root drmrpc
    seclabel u:r:recovery:s0

# mcDriverDaemon --P1 needs the persist partition mounted before it starts.
# `on fs` demonstrably fires in recovery (microtrust.rc's `start teei_daemon (on fs)`
# appears in /proc/bootprof), and runs before the recovery binary attempts decryption.
on fs
    mkdir /mnt/vendor 0771 root root
    mkdir /mnt/vendor/persist 0771 root root
    mkdir /mnt/vendor/persist/mcRegistry 0771 root root
    wait /dev/block/by-name/persist 10
    mount ext4 /dev/block/by-name/persist /mnt/vendor/persist
    start mobicore

on property:ro.vendor.trustonic.ready=true
    start keymaster-5-0
    start gatekeeper-1-0
    start keystore2

# 解密完成后停掉 TEE 相关服务 (参考树 PD2415(3) 的生命周期), 省内存.
# teei_daemon 由 microtrust.rc 的 on fs 在二进制就位后自动拉起.
on property:twrp.decrypt.done=true
    stop teei_daemon
    stop keymaster-5-0
    stop gatekeeper-1-0
    stop mobicore

service twrpdump /system/bin/sh /twrp_logdump.sh
    seclabel u:r:recovery:s0
    user root
    group root
    oneshot
    disabled

on property:sys.usb.config=mtp,adb && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/UDC "none"
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    start adbd

on property:sys.usb.ffs.ready=1 && property:sys.usb.config=mtp,adb && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp_adb"
    symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state ${sys.usb.config}
