import /microtrust.rc

exec u:r:recovery:s0 root root -- /system/bin/sh /bcb_clear.sh

on boot
    symlink /dev/block/mapper/pl_a /dev/block/by-name/preloader_raw_a
    symlink /dev/block/mapper/pl_b /dev/block/by-name/preloader_raw_b
    
    setprop sys.usb.config adb
    start adbd

    start twrpdump

   
    write /sys/class/leds/lcd-backlight/brightness 1400
    start mobicore

    start vendor.boot-default


    start vendor.health-default

service vendor.boot-default /system/bin/hw/android.hardware.boot-service.mtk_recovery
    class early_hal
    user root
    group root
    seclabel u:r:recovery:s0
    interface aidl android.hardware.boot.IBootControl/default

service vendor.health-default /system/bin/hw/android.hardware.health-service.example_recovery
    class hal
    seclabel u:r:recovery:s0
    user system
    group system
    capabilities WAKE_ALARM BLOCK_SUSPEND
    file /dev/kmsg w


on property:ro.vendor.trustonic.ready=true
    start keystore2

service twrpdump /system/bin/sh /twrp_logdump.sh
    seclabel u:r:recovery:s0
    user root
    group root
    oneshot
    disabled

on property:sys.usb.config=mtp,adb && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/UDC "none"
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    start adbd

on property:sys.usb.ffs.ready=1 && property:sys.usb.config=mtp,adb && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp_adb"
    symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state ${sys.usb.config}
